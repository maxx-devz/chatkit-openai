# Create a fresh key at https://platform.openai.com/api-keys
# Never commit your real key or expose it in browser-side code.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# Neon Postgres connection string. Keep this server-only.
DATABASE_URL=

# Generate a different random value for every environment. Minimum 32 chars.
BETTER_AUTH_SECRET=

# Must exactly match the site origin. No trailing slash.
# Local: http://127.0.0.1:3000
# Vercel: https://your-portal-domain.vercel.app
BETTER_AUTH_URL=http://127.0.0.1:3000

# Optional Hubstaff organization access token. Keep this server-only; never
# name it NEXT_PUBLIC_* or expose it in browser code.
# Create it in Hubstaff: Settings -> Organization -> API tokens.
HUBSTAFF_ACCESS_TOKEN=

# Optional fallback used only when a Hubstaff project has no monthly hours
# budget. Leave blank to show an unavailable remaining-hours value instead of
# inventing a limit.
HUBSTAFF_MONTHLY_HOURS_DEFAULT=
