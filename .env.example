# Create a fresh key at https://platform.openai.com/api-keys
# Never commit your real key or expose it in browser-side code.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# Neon Postgres connection string. Keep this server-only.
DATABASE_URL=

# Prototype tenant identity. Real production identity must come from login.
PORTAL_CLIENT_SLUG=churchbanners
PORTAL_CLIENT_NAME=ChurchBanners
PORTAL_USER_ID=prototype-user
