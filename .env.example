# Safe configuration template. Keep real credentials and account-specific values
# in .env.local or the deployment's environment settings, never in this file.

# AI keys and chat models are managed in AOC Admin > AI provider settings.
# Optional server-only environment fallback when no saved provider setting exists.
# Leave blank when using AOC Admin; do not duplicate its saved credentials here.
OPENAI_API_KEY=
OPENAI_MODEL=

# Encrypts saved provider keys. Generate a random secret of at least 32 chars.
# Use the SAME stable value on Next.js and Python. Back it up securely.
# Do not change it without re-encrypting saved keys; never use NEXT_PUBLIC_.
PROVIDER_SETTINGS_SECRET=
# Optional OpenRouter attribution. Defaults to BETTER_AUTH_URL and the AOC name.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Always Open Commerce Portal

# Optional Google Drive source integration (requires the source feature branch).
# Server-only Web OAuth credentials. Callback origin must match BETTER_AUTH_URL:
# http://127.0.0.1:3000/api/admin/source-connections/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Stable random encryption key of at least 32 characters; keep it server-only.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# Authorized Google account and approved parent folder ID; configure per environment.
GOOGLE_DRIVE_ALLOWED_EMAIL=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# PostgreSQL connection string (currently Neon). Keep this server-only.
# For TLS connections, use sslmode=verify-full to verify the certificate and
# hostname explicitly and avoid the node-postgres sslmode=require warning.
DATABASE_URL=
# Optional shared Node pool limit (1-10). Defaults to 3. Start with 1 when using
# a serverless Supabase transaction-pooler connection, then load-test before raising.
DATABASE_POOL_MAX=3

# Generate a different random value for every environment. Minimum 32 chars.
BETTER_AUTH_SECRET=

# Must exactly match the site origin. No trailing slash.
# Local: http://127.0.0.1:3000
# Vercel: https://your-portal-domain.vercel.app
BETTER_AUTH_URL=http://127.0.0.1:3000

# Hubstaff authentication. Keep these server-only; never name them NEXT_PUBLIC_*.
# Members: put the initial PAT refresh token in HUBSTAFF_PAT_REFRESH_TOKEN and
# generate a stable random HUBSTAFF_TOKEN_ENCRYPTION_KEY (minimum 32 chars).
# Organization owners may instead place an hsoat_ organization token in
# HUBSTAFF_ACCESS_TOKEN. Leave unused choices blank.
HUBSTAFF_ACCESS_TOKEN=
# Hubstaff team ID for internal-user provisioning. Only active, unmapped members
# of this team may be selected; verify it belongs to the organization above.
HUBSTAFF_INTERNAL_TEAM_ID=
# Enable shift labels only after confirming the Hubstaff schedule covers every
# mapped Team member. Without this, approved leave can show Away; others stay Unknown.
HUBSTAFF_TEAM_SCHEDULES_VERIFIED=false
HUBSTAFF_PAT_REFRESH_TOKEN=
HUBSTAFF_TOKEN_ENCRYPTION_KEY=
# Personal Hubstaff OAuth app. Register the exact callback URL in Hubstaff.
# Use separate OAuth apps/callbacks for localhost, staging, and production.
HUBSTAFF_OAUTH_CLIENT_ID=
HUBSTAFF_OAUTH_CLIENT_SECRET=
HUBSTAFF_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/internal/hubstaff/oauth/callback

# IANA timezone used to decide today's date and the current month for Hubstaff
# queries. Match the Hubstaff organization timezone (example: Asia/Manila).
HUBSTAFF_REPORT_TIME_ZONE=UTC

# Server-only Make custom webhook used by the administrator connection test.
# Create separate webhooks for staging and production. Never use NEXT_PUBLIC_.
MAKE_WEBHOOK_URL=

# Public domain key from OpenAI's ChatKit domain registration. This is NOT
# an OpenAI API key. Register the exact local / preview / production domains.
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=

# Server-only Python service origin. npm run dev uses port 8000 locally.
# Vercel: https://YOUR-CHATKIT-BACKEND.vercel.app
CHATKIT_BACKEND_URL=http://127.0.0.1:8000

# Same random secret (at least 32 characters) on the Next.js and Python projects.
# npm run dev generates an ephemeral local secret if this is blank.
CHATKIT_BACKEND_SECRET=

# Optional Vercel deployment-protection automation bypass token for the backend.
# Set ONLY on the Next.js project if the Python deployment requires it.
CHATKIT_VERCEL_PROTECTION_BYPASS=

# Optional image model for the Python generation tool. Requires a genuine
# OpenAI key saved in AOC Admin, even when chat uses OpenRouter.
# Set this on the Python Vercel project when enabling images in /builder.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: uploads default to enabled after npm run uploads:migrate.
# Set false on BOTH Vercel projects to disable new attachments.
# No external virus-scanning service is used. Existing API/DB credentials suffice.
CHATKIT_UPLOADS_ENABLED=true

# Browser-private observability. Enable explicitly locally OR in production.
# All signed-in accounts can inspect only this browser's own activity.
# Optional allowlist restricts access by auth user ID, email or username.
DEBUGGER=false
DEBUGGER_DEVELOPERS=
DEBUGGER_MAX_RECORDS=2500
# Bodies are ALWAYS off in production. Development opt-in needs safe GET paths.
# Auth, ChatKit, credentials, files and provider settings are always excluded.
DEBUGGER_CAPTURE_BODIES=false
DEBUGGER_BODY_PATHS=
