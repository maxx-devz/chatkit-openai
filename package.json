{
  "name": "aoc-gpt-portal-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint app components config lib scripts next.config.mjs proxy.js",
    "auth:migrate": "node --env-file=.env.local scripts/migrate-auth.mjs",
    "portal:migrate": "node --env-file=.env.local scripts/migrate-portal.mjs",
    "admin:migrate": "node --env-file=.env.local scripts/migrate-admin.mjs",
    "chatkit:migrate": "node --env-file=.env.local scripts/migrate-chatkit.mjs",
    "uploads:migrate": "node --env-file=.env.local scripts/migrate-uploads.mjs",
    "library:migrate": "node --env-file=.env.local scripts/migrate-library.mjs",
    "builder:migrate": "node --env-file=.env.local scripts/migrate-builder.mjs",
    "usage:migrate": "node --env-file=.env.local scripts/migrate-usage.mjs",
    "site-ai:migrate": "node --env-file=.env.local scripts/migrate-site-ai.mjs",
    "test:builder": "node --test tests/builder-config.test.mjs",
    "test:chatkit": "node --test tests/chatkit-security.test.mjs",
    "client:create": "node --env-file=.env.local scripts/create-client.mjs",
    "client:delete": "node --env-file=.env.local scripts/delete-client.mjs",
    "list:client": "node --env-file=.env.local scripts/list-clients.mjs",
    "hubstaff:check": "node --conditions=react-server --env-file=.env.local scripts/check-hubstaff.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "internal-user:migrate": "node --env-file=.env.local scripts/migrate-internal-user.mjs",
    "integration-audit:migrate": "node --env-file=.env.local scripts/migrate-integration-audit.mjs",
    "internal-sync:migrate": "node --env-file=.env.local scripts/migrate-internal-sync.mjs",
    "internal-sync:check": "node --env-file=.env.local scripts/check-internal-sync.mjs",
    "internal-user:create": "node --env-file=.env.local scripts/create-internal-user.mjs",
    "internal-user:role": "node --env-file=.env.local scripts/set-internal-role.mjs",
    "test:internal-user": "node --conditions=react-server --experimental-test-module-mocks --import ./tests/internal-user/aliases.mjs --test tests/internal-user/*.test.mjs",
    "test:internal-user:database": "node --env-file=.env.local scripts/check-internal-user-database.mjs",
    "test:internal-user:ui": "playwright test --config tests/internal-user/playwright.config.mjs",
    "test:internal-user:http": "node --env-file=.env.local scripts/check-internal-user-http.mjs",
    "test:internal-user:secrets": "node --env-file=.env.local scripts/check-internal-user-secrets.mjs",
    "employee:migrate": "npm run internal-user:migrate",
    "employee:create": "npm run internal-user:create --",
    "test:employee": "npm run test:internal-user",
    "test:employee:database": "npm run test:internal-user:database",
    "test:employee:ui": "npm run test:internal-user:ui",
    "test:employee:http": "npm run test:internal-user:http --",
    "test:employee:secrets": "npm run test:internal-user:secrets",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:http": "node scripts/check-builder-http.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openai/chatkit-react": "1.6.1",
    "better-auth": "^1.7.2",
    "next": "^16.3.3",
    "openai": "^7.7.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3"
  }
}
