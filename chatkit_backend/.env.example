# Vercel Python project: Root Directory = chatkit_backend, preset = FastAPI.
# Locally npm run dev inherits the root .env.local; no copy is needed here.
# AI provider keys and chat models are saved through AOC Admin.
# Must match the stable encryption secret on the Next.js project.
PROVIDER_SETTINGS_SECRET=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Always Open Commerce Portal

# Optional switch for new attachments; defaults to true. Run uploads:migrate first.
CHATKIT_UPLOADS_ENABLED=true
DATABASE_URL=
# Must match CHATKIT_BACKEND_SECRET on the Next.js project (at least 32 chars).
CHATKIT_BACKEND_SECRET=
OPENAI_IMAGE_MODEL=gpt-image-2
